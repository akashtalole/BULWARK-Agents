# Copy to .env for local development: `cp .env.example .env`
# (main.py doesn't auto-load .env; export these, or use `dotenv run`.)

# --- Gemini access (pick ONE path) -----------------------------------------
# Path A: Gemini API / Google AI Studio
GOOGLE_API_KEY=

# Path B: Vertex AI (uses Application Default Credentials, e.g. `gcloud auth
# application-default login`, or the Cloud Run service account in prod)
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_GENAI_USE_VERTEXAI=true

# Flash powers six of the seven agents; Pro is reserved for Risk Assessor's
# final cross-referencing judgment (see docs/architecture.md).
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-pro-latest

# --- Google Cloud / Firestore (control-evidence graph, audit log) ---------
# Leave GOOGLE_CLOUD_PROJECT unset to run fully in-memory with zero cloud
# setup. Set it (and USE_FIRESTORE=true) to persist to Firestore instead.
# GOOGLE_CLOUD_PROJECT=my-project
USE_FIRESTORE=true
FIRESTORE_DATABASE=(default)

# --- Pub/Sub -----------------------------------------------------------
# The event bus always dispatches in-process (see platform/event_bus.py);
# set this to true to *also* mirror every publish onto real Pub/Sub topics
# (provisioned by deploy/setup_gcp.sh) so a demo can show live topic
# metrics in Cloud Console.
USE_PUBSUB=false

# --- Agent Gateway ingress auth -----------------------------------------
BULWARK_API_KEYS=demo-key
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Origins allowed to call the API cross-origin -- the frontend/ dashboard's
# origin. Defaults already cover the local Vite dev server.
BULWARK_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Tuning knobs --------------------------------------------------------
ANSWER_CONFIDENCE_THRESHOLD=0.75
EVIDENCE_FRESHNESS_DAYS=30
EVIDENCE_SWEEP_HOURS=6
DRIFT_SWEEP_HOURS=24

BULWARK_DEFAULT_TENANT=acme-eu
BULWARK_SERVICE_NAME=bulwark
BULWARK_SERVICE_VERSION=0.1.0
BULWARK_ENVIRONMENT=local
